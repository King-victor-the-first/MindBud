
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Allow read access to all files for any user.
    // This is a broad rule; for production, you might want to restrict this further.
    match /{allPaths=**} {
      allow read;
    }

    // Rules for chat image uploads
    match /chat/{userId}/{fileName} {
      // Allow authenticated users to write to their own chat folder.
      allow write: if request.auth != null && request.auth.uid == userId
                   // Ensure the uploaded file is an image.
                   && request.resource.contentType.matches('image/.*')
                   // Restrict file size to under 5MB.
                   && request.resource.size < 5 * 1024 * 1024;
    }
  }
}
