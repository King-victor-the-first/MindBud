rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Allow users to read and write to their own profile and all subcollections within it.
    match /userProfiles/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Allow any authenticated user to read and write to the group chat.
    match /groupChatMessages/{messageId} {
      allow read, write: if request.auth != null;
    }
  }
}
