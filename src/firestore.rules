rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // User Profiles
    match /userProfiles/{userId} {
      // READ: 
      // 1. Any authenticated user can read their OWN profile.
      // 2. A user who is a moderator can read ANY profile (needed for the admin page).
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isModerator == true
      );

      // WRITE: A user can only write to their own profile. This does NOT grant subcollection access.
      allow write: if request.auth != null && request.auth.uid == userId;
    }
      
    // User Subcollections (moods, journal, etc.)
    match /userProfiles/{userId}/{document=**} {
        // WRITE: A user can only write to subcollections within their own profile.
        allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Group Chat
    match /groupChatMessages/{messageId} {
      // Allow any authenticated user to read and write to the group chat.
      allow read, write: if request.auth != null;
    }
  }
}
