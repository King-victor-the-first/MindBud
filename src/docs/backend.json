

{
  "entities": {
    "User": {
      "title": "User",
      "description": "Represents a user in the system.",
      "type": "object",
      "properties": {
        "username": {
          "type": "string",
          "description": "The user's display name."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The user's email address."
        },
        "avatarUrl": {
          "type": "string",
          "description": "URL for the user's avatar."
        },
        "isModerator": {
            "type": "boolean",
            "description": "Indicates if the user has moderator privileges."
        },
        "presence": {
          "type": "object",
          "description": "User's real-time presence information.",
          "properties": {
            "state": {
              "type": "string",
              "enum": ["online", "offline"],
              "description": "The user's current presence state."
            },
            "lastChanged": {
              "type": "string",
              "format": "date-time",
              "description": "The timestamp when the presence state last changed."
            }
          }
        }
      },
      "required": ["username", "email"]
    },
    "MoodEntry": {
      "title": "Mood Entry",
      "description": "Represents a single mood entry for a user.",
      "type": "object",
      "properties": {
        "mood": {
          "type": "string",
          "description": "The user's reported mood.",
          "enum": ["Awful", "Bad", "Okay", "Good", "Great"]
        },
        "value": {
            "type": "number",
            "description": "A numerical representation of the mood (e.g., 1-5)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "The timestamp when the mood was logged."
        },
        "trigger": {
            "type": "string",
            "description": "The primary reason for the mood (e.g., Academics, Social)."
        },
        "triggerNote": {
            "type": "string",
            "description": "A user-written note for additional context on the trigger."
        }
      },
      "required": ["mood", "value", "createdAt"]
    },
    "GratitudeEntry": {
      "title": "Gratitude Journal Entry",
      "description": "A single entry in a user's gratitude journal.",
      "type": "object",
      "properties": {
        "date": {
          "type": "string",
          "format": "date",
          "description": "The date of the entry in YYYY-MM-DD format."
        },
        "entry": {
          "type": "string",
          "description": "The text content of the gratitude entry."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "The timestamp when the entry was created."
        }
      },
      "required": ["date", "entry", "createdAt"]
    },
    "SafetyPlan": {
        "title": "User Safety Plan",
        "description": "Stores a user's personalized safety plan for moments of crisis.",
        "type": "object",
        "properties": {
            "trustedContacts": {
                "type": "array",
                "items": {
                    "type": "object",
                    "properties": {
                        "name": {"type": "string"},
                        "phone": {"type": "string"}
                    },
                    "required": ["name", "phone"]
                }
            },
            "emergencyResources": {
                "type": "array",
                "items": {
                    "type": "object",
                    "properties": {
                        "name": {"type": "string"},
                        "phone": {"type": "string"}
                    },
                     "required": ["name", "phone"]
                }
            },
            "copingStrategies": {
                "type": "string",
                "description": "A user-written text of personal coping strategies."
            }
        }
    },
    "ChatMessage": {
      "title": "Chat Message",
      "description": "Represents a single message in the group chat.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "The ID of the user who sent the message."
        },
        "userName": {
          "type": "string",
          "description": "The display name of the user."
        },
        "message": {
          "type": "string",
          "description": "The content of the chat message."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "The timestamp when the message was sent."
        },
        "isModerator": {
          "type": "boolean",
          "description": "Whether the sending user is a moderator."
        },
        "avatarUrl": {
            "type": "string",
            "description": "URL for the user's avatar."
        },
        "isDeleted": {
            "type": "boolean",
            "description": "Flag for soft-deleted messages."
        },
        "mediaUrl": {
          "type": "string",
          "description": "The URL of any shared media."
        },
        "mediaType": {
          "type": "string",
          "description": "The MIME type of the shared media (e.g., 'image/jpeg')."
        },
        "replyTo": {
          "type": "object",
          "description": "Information about the message being replied to.",
          "properties": {
            "messageId": {
              "type": "string"
            },
            "messageOwner": {
              "type": "string"
            },
            "messageSnippet": {
              "type": "string"
            }
          }
        }
      },
      "required": ["userId", "userName", "createdAt"]
    },
     "TherapySession": {
      "title": "Therapy Session",
      "description": "Represents a single AI therapy session.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string"
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "summary": {
          "type": "string"
        }
      }
    },
    "TherapyMessage": {
      "title": "Therapy Message",
      "description": "A single message within an AI therapy session.",
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "enum": ["user", "model"]
        },
        "content": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "text": { "type": "string" }
                }
            }
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "Medication": {
      "title": "Medication",
      "description": "Represents a single medication reminder for a user.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the medication."
        },
        "dosage": {
          "type": "string",
          "description": "The dosage of the medication (e.g., 10mg)."
        },
        "time": {
          "type": "string",
          "format": "time",
          "description": "The time for the reminder (e.g., 09:00)."
        }
      },
      "required": ["name", "dosage", "time"]
    },
    "DailyInsight": {
        "title": "Daily Insight",
        "description": "A personalized insight for the user.",
        "type": "object",
        "properties": {
            "insight": {
                "type": "string",
                "description": "The generated insight text."
            }
        },
        "required": ["insight"]
    },
    "BuddyApplication": {
        "title": "Buddy Application",
        "description": "An application from a professional or student to become a Mind Buddy.",
        "type": "object",
        "properties": {
            "userId": {"type": "string"},
            "role": {"type": "string", "enum": ["professional", "student"]},
            "fullName": {"type": "string"},
            "email": {"type": "string", "format": "email"},
            "licenseNumber": {"type": "string"},
            "university": {"type": "string"},
            "programOfStudy": {"type": "string"},
            "specializations": {"type": "string"},
            "yearsExperience": {"type": "number"},
            "hoursPerWeek": {"type": "string"},
            "reasonToJoin": {"type": "string"},
            "status": {"type": "string", "enum": ["pending", "approved", "rejected"]},
            "submittedAt": {"type": "string", "format": "date-time"}
        },
        "required": ["userId", "role", "fullName", "email", "specializations", "yearsExperience", "hoursPerWeek", "reasonToJoin", "status", "submittedAt"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous", "google.com", "apple.com"]
  },
  "firestore": {
    "/userProfiles/{userId}": {
      "schema": {
        "$ref": "#/entities/User"
      },
      "description": "Stores public profile information for a user."
    },
    "/userProfiles/{userId}/moodEntries/{entryId}": {
        "schema": {
            "$ref": "#/entities/MoodEntry"
        },
        "description": "Stores a user's mood entries over time."
    },
    "/userProfiles/{userId}/gratitudeJournal/{YYYY-MM-DD}": {
        "schema": {
            "$ref": "#/entities/GratitudeEntry"
        },
        "description": "Stores a user's daily gratitude journal entries."
    },
    "/userProfiles/{userId}/safetyPlan/userPlan": {
        "schema": {
            "$ref": "#/entities/SafetyPlan"
        },
        "description": "A single document containing the user's safety plan."
    },
    "/userProfiles/{userId}/medications/{medicationId}": {
      "schema": {
        "$ref": "#/entities/Medication"
      },
      "description": "Stores a user's medication reminders."
    },
    "/groupChatMessages/{messageId}": {
      "schema": {
        "$ref": "#/entities/ChatMessage"
      },
      "description": "Stores messages for the anonymous peer-to-peer group chat."
    },
    "/userProfiles/{userId}/therapySessions/{sessionId}": {
      "schema": {
        "$ref": "#/entities/TherapySession"
      },
      "description": "Stores metadata for an AI therapy session."
    },
    "/userProfiles/{userId}/therapySessions/{sessionId}/messages/{messageId}": {
      "schema": {
        "$ref": "#/entities/TherapyMessage"
      },
      "description": "Stores individual messages for a specific AI therapy session."
    },
    "/buddyApplications/{applicationId}": {
        "schema": {
            "$ref": "#/entities/BuddyApplication"
        },
        "description": "Stores applications from therapists wanting to become Mind Buddies."
    }
  }
}
